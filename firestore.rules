rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function chatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // User profiles
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if self(uid);

      match /following/{targetUid} {
        allow read: if signedIn();
        allow create, delete: if self(uid) && targetUid != uid;
        allow update: if false;
      }

      match /deviceTokens/{token} {
        allow read: if self(uid);
        allow create, update: if self(uid)
          && request.resource.data.token == token;
        allow delete: if self(uid);
      }

      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create, delete: if self(followerUid) && followerUid != uid;
        allow update: if false;
      }
    }

    // Private 1-to-1 chats. Members are immutable after creation.
    match /chats/{chatId} {
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members;

      allow read: if chatMember(chatId);

      allow update: if chatMember(chatId)
        && request.resource.data.members == resource.data.members;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if chatMember(chatId);

        allow create: if chatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId in
             get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        allow update, delete: if false;
      }
    }


    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaType in ['photo', 'video']
        && request.resource.data.caption is string;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /likes/{userId} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    // User notifications
    match /users/{uid}/notifications/{notificationId} {
      allow read: if self(uid);
      // Notifications are created only by trusted backend code.
      allow create: if false;
      // The owner may only change the read flag.
      allow update: if self(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if self(uid);
    }

    // Everything else is blocked by default.
  }
}
